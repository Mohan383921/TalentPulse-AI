# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Supabase project URL for PostgreSQL database and authentication.
SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_URL="MY_SUPABASE_URL"

# SUPABASE_ANON_KEY: Supabase public anonymous API key.
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


